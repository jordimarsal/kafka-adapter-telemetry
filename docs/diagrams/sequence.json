    {
      "dot": "cyan",
      "title": "Idempotency",
      "items": [
        "The Oracle primary key is the referee",
        "A replay is an expected Result.Err, not an exception"
      ]
    },
    {
      "dot": "amber",
      "title": "Domain decisions",
      "items": [
        "AdapterHealth.observe returns the next state plus an optional alert",
